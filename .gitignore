# Dependencies installed from Composer or npm.
/vendor/
/node_modules/
/frontend/node_modules/
/web/core/
/web/modules/contrib/
/web/themes/contrib/

# Build and generated frontend artifacts.
/frontend/.next/
/frontend/out/
/frontend/build/
/frontend/.canvas/
/frontend/coverage/
/frontend/*.tsbuildinfo

# Drupal runtime files.
/web/sites/*/files/
/web/sites/*/private/
/web/sites/*/settings.local.php

# Local environment files.
.env
.env.*
!.env.example
/frontend/.env
/frontend/.env.*
!/frontend/.env.example

# Logs and local tooling.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
.idea/
.fleet/
